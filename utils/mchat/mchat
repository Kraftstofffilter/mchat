#!/usr/bin/env bash
# mchat: attach to the background mchat session, starting it if needed.
#
# mchat runs once, detached under dtach (systemd user unit mchat.service), so
# a herdr pane and browser tabs (ttyd, mchat-web.service) all show the same
# session. With arguments (--setup, --set-pin, ...) the binary runs directly;
# stop mchat.service first for --setup.

BIN="${HOME}/.local/bin/mchat-bin"
SOCK="${XDG_RUNTIME_DIR:-/tmp}/mchat.dtach"
PANE_FILE="${HOME}/.local/share/mchat/attached-pane"

if [[ $# -gt 0 ]]; then
  exec "${BIN}" "$@"
fi

systemctl --user start mchat.service
for _ in $(seq 50); do
  [[ -S "${SOCK}" ]] && break
  sleep 0.1
done

# inside herdr: note the pane, so the privacy lock can watch its focus
if [[ -n "${HERDR_PANE_ID:-}" ]]; then
  mkdir -p "$(dirname "${PANE_FILE}")"
  echo "${HERDR_PANE_ID}" > "${PANE_FILE}"
  trap 'rm -f "${PANE_FILE}"' EXIT
fi

# -r winch: redraw on attach; -E: no detach key (close the pane or tab)
"${HOME}/.local/bin/dtach" -a "${SOCK}" -r winch -E
