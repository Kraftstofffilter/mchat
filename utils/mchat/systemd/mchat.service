[Unit]
Description=mchat (detached, attach with: mchat)
# keeps retrying while another mchat holds the config lock
StartLimitIntervalSec=0

[Service]
Environment=TERM=xterm-256color COLORTERM=truecolor LANG=C.UTF-8
ExecStart=%h/.local/bin/dtach -N %t/mchat.dtach -r winch -E %h/.local/bin/mchat-bin
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
